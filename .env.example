# AIPlex Local Development Environment Variables
#
# Copy to .env and modify:
#   cp .env.example .env
#
# Used by: make run-local, docker-compose

# ── API Server ──────────────────────────────────────────

AIPLEX_HOST=0.0.0.0
AIPLEX_PORT=8080
LOG_LEVEL=debug

# ── Auth (Ory Hydra) ───────────────────────────────────

HYDRA_ADMIN_URL=http://localhost:4445

# ── Firestore ──────────────────────────────────────────

# For local dev with emulator:
FIRESTORE_EMULATOR_HOST=localhost:8086
FIRESTORE_PROJECT_ID=aiplex-dev

# For production (remove emulator host):
# GCP_PROJECT_ID=my-gcp-project

# ── Identity ───────────────────────────────────────────

TRUST_DOMAIN=aiplex-dev.svc.id.goog

# ── CLI ────────────────────────────────────────────────

# Used by aiplex CLI when --url/--token not specified:
# AIPLEX_URL=http://localhost:8080
# AIPLEX_TOKEN=your-jwt-token

# Explicit local-only development. Production requires verified identity config.
HOST=127.0.0.1
AIPLEX_DEV_MODE=true
AIPLEX_MODULES=mcplex,a2aplex,llmplex,skillsplex
# Production single-source identity (or use AIPLEX_IDENTITY_PROVIDERS_FILE):
# JWT_ISSUER=https://issuer.example
# JWT_AUDIENCE=aiplex-api
# JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# IDENTITY_WORKFORCE=true
# AIPLEX_MODULE_MANIFEST=/etc/aiplex/modules.json
# AIPLEX_IDENTITY_PROVIDERS_FILE=/etc/aiplex/identity.json
# AUTH_HOOK_TOKEN must also be configured on the Hydra token-hook caller.
