# Release image for the aiplex CLI, built by GoReleaser's dockers_v2 (see .goreleaser.yaml).
# GoReleaser lays out the build context as $TARGETPLATFORM/<binary> (for example
# linux/amd64/aiplex), so the prebuilt binary for each platform is copied from there.
#
# NOTE: `aiplex dev` (local mode) needs the aiplex-api binary beside the CLI,
# which this image does not contain. This image is for running commands
# against a platform (a deployed aiplex-api), not for local mode.
FROM gcr.io/distroless/static-debian12:nonroot

ARG TARGETPLATFORM

LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.title="aiplex"
LABEL org.opencontainers.image.description="CLI for aiplex"

COPY $TARGETPLATFORM/aiplex /aiplex

USER 65532:65532

ENTRYPOINT ["/aiplex"]
