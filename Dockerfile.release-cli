# Release image for the aiplex CLI, used by GoReleaser (dockers: buildx).
# The prebuilt linux binary is copied from the goreleaser build context.
#
# NOTE: `aiplex dev` (local mode) needs the aiplex-api binary beside the CLI,
# which this image does not contain. This image is for running commands
# against a platform (a deployed aiplex-api), not for local mode.
FROM gcr.io/distroless/static-debian12:nonroot

ARG SOURCE="https://github.com/vamsiramakrishnan/aiplex"
ARG VERSION=""
ARG REVISION=""
ARG TITLE="aiplex"
ARG DESCRIPTION="CLI for aiplex"

LABEL org.opencontainers.image.source="${SOURCE}"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${REVISION}"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.title="${TITLE}"
LABEL org.opencontainers.image.description="${DESCRIPTION}"

COPY aiplex /aiplex

USER 65532:65532

ENTRYPOINT ["/aiplex"]
