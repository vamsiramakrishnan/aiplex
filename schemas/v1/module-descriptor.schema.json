{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplex.dev/schemas/v1/module-descriptor.schema.json",
  "title": "AIPlex module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "contract_version": {
      "const": "v1"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "contract_version": {
            "const": "v1"
          },
          "min_version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "contract_version"
        ]
      }
    },
    "api_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?:[^/?#%\\\\\\s]+/)*[^/?#%\\\\\\s]+$",
        "not": {
          "pattern": "(^|/)\\.{1,2}(/|$)"
        }
      }
    },
    "navigation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "anyOf": [
              {
                "const": "/"
              },
              {
                "type": "string",
                "pattern": "^/(?:[^/?#%\\\\\\s]+/)*[^/?#%\\\\\\s]+$",
                "not": {
                  "pattern": "(^|/)\\.{1,2}(/|$)"
                }
              }
            ]
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "title"
        ]
      }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ]
      }
    },
    "config_schema": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "version",
    "contract_version"
  ]
}
