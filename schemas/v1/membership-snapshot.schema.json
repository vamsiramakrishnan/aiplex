{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplex.dev/schemas/v1/membership-snapshot.schema.json",
  "title": "AIPlex membership snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "v1"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "ref",
    "tenant_id",
    "principal_id",
    "groups",
    "issued_at",
    "expires_at"
  ]
}
