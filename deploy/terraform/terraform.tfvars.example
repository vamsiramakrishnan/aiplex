# AIPlex Terraform Variables
#
# Copy this file and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Or generate interactively:
#   aiplex init

# ── Required ─────────────────────────────────────────────

# GCP project ID (must exist, billing enabled)
project_id = "my-gcp-project"

# GCP region for all resources
# Recommended: us-central1, europe-west1, asia-southeast1
region = "us-central1"

# Domain for AIPlex HTTPS endpoint
# A DNS record must point to the load balancer IP after deploy
domain = "aiplex.example.com"

# ── Optional ─────────────────────────────────────────────

# E-mail for Cloud Monitoring alert notifications (creates a channel)
# alert_email = "admin@example.com"

# AlloyDB sizing (vCPUs — minimum 2)
# Dev: 2, Staging: 4, Production: 8+
# alloydb_cpu_count = 2

# GKE network: "default" (the project's default network; the original
# behaviour and the default) or "aiplex" (the dedicated VPC with Private Google
# Access and Cloud NAT; `aiplex init` writes this for new installs).
# Changing it on an existing cluster REPLACES the cluster.
# cluster_network = "default"

# ── Workload Identity Federation (for external agents) ───
# Only needed if agents run outside GCP (AWS, Azure, on-prem). Each identity
# provider is created only when its variable is set.

# AWS account whose IAM roles external agents assume (12 digits), and the role
# name they assume in it
# aws_account_id = "123456789012"
# aws_agent_role = "aiplex-agent"

# Azure AD tenant of external agents
# azure_agent_tenant_id = "00000000-0000-0000-0000-000000000000"
#
# Every name in this file must be a declared variable (TestInitTFVarsAreDeclared).
